{
    "name": "boxes",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev:sass": "sass --watch . --no-source-map",
        "dev:css-to-ts": "node ./scripts/css-to-ts.js ./src --watch",
        "dev:storybook": "storybook dev -p 6006",
        "dev": "run-p dev:*",
        "stylelint": "stylelint \"**/*.scss\"",
        "eslint": "eslint \"src/**/*.{ts,mdx}\"",
        "lint": "run-p stylelint eslint",
        "build:sass": "sass . --no-source-map",
        "build:css-to-ts": "node ./scripts/css-to-ts.js ./src",
        "build:styles": "run-s build:sass build:css-to-ts",
        "build": "build:sass && build:css-to-ts && vite build",
        "build:storybook": "storybook build",
        "build:pages": "run-s build:styles build:storybook",
        "wdio": "wdio run ./wdio.conf.ts",
        "wdio:headless": "wdio run ./wdio-headless.conf.ts",
        "test": "run-s build:styles wdio",
        "test:headless": "run-s build:styles wdio:headless",
        "boxes:g": "node ./scripts/generate.js"
    },
    "devDependencies": {
        "@chromatic-com/storybook": "1.6.1",
        "@eslint/js": "^9.34.0",
        "@storybook/addon-essentials": "^8.6.14",
        "@storybook/addon-links": "^8.6.14",
        "@storybook/blocks": "^8.6.14",
        "@storybook/test": "^8.6.14",
        "@storybook/web-components": "^8.6.14",
        "@storybook/web-components-vite": "^8.6.14",
        "@testing-library/webdriverio": "^3.2.1",
        "@types/eslint__js": "^8.42.3",
        "@wdio/browser-runner": "^9.19.2",
        "@wdio/cli": "^9.19.2",
        "@wdio/mocha-framework": "^9.19.2",
        "@wdio/spec-reporter": "^9.19.2",
        "eslint-plugin-lit": "^1.15.0",
        "eslint-plugin-mdx": "^3.6.2",
        "lit": "^3.3.1",
        "node-watch": "^0.7.4",
        "npm-run-all": "^4.1.5",
        "prettier": "^3.6.2",
        "prettier-plugin-sort-imports": "^1.8.8",
        "sass": "^1.91.0",
        "storybook": "^8.6.14",
        "stylelint": "^16.23.1",
        "stylelint-config-clean-order": "^6.1.0",
        "stylelint-config-standard-scss": "^13.1.0",
        "typescript": "^5.9.2",
        "typescript-eslint": "^7.18.0",
        "vite": "^5.4.19",
        "wdio-wait-for": "^3.1.0"
    },
    "packageManager": "pnpm@10.14.0+sha512.ad27a79641b49c3e481a16a805baa71817a04bbe06a38d17e60e2eaee83f6a146c6a688125f5792e48dd5ba30e7da52a5cda4c3992b9ccf333f9ce223af84748"
}
